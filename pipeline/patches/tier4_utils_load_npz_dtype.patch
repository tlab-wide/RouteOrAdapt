+
+@torch.no_grad()
+def generate_k_trajectories(
+    policy_model,
+    model_args,
+    data: dict[str, torch.Tensor],
+    k: int = 8,
+    noise_scale: float = 1.0,
+    device: torch.device | None = None,
+) -> list[np.ndarray]:
+    """Generate K diverse trajectories from different initial noise seeds.
+
+    Args:
+        policy_model: Diffusion Planner model in eval mode
+        model_args: model config
+        data: single NPZ input (batch size 1)
+        k: number of trajectories to sample
+        noise_scale: scale of initial noise (0 = deterministic)
+        device: torch device
+
+    Returns:
+        List of K trajectories, each [T, 4] (x, y, cos_h, sin_h)
+    """
+    device = device or next(policy_model.parameters()).device
+    data = {k_: v.clone().to(device) if isinstance(v, torch.Tensor) else v for k_, v in data.items()}
+    data = model_args.observation_normalizer(data)
+    B = data["ego_current_state"].shape[0]
+    P = 1 + model_args.predicted_neighbor_num
+    future_len = model_args.future_len
+
+    trajectories = []
+    for i in range(k):
+        if i == 0:
+            # First trajectory: deterministic (temperature 0)
+            data["sampled_trajectories"] = torch.zeros(B, P, future_len + 1, 4).to(device)
+        else:
+            data["sampled_trajectories"] = noise_scale * torch.randn(B, P, future_len + 1, 4).to(
+                device
+            )
+        _, outputs = policy_model(data)
+        ego_prediction = outputs["prediction"][0, 0].cpu().numpy()  # [T, 4]
+        trajectories.append(ego_prediction)
+
+    return trajectories
